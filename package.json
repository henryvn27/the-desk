{
  "name": "the-desk",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/**/*.test.ts",
    "start": "node scripts/start.mjs",
    "check:electron-only": "node scripts/check-electron-only.mjs",
    "check": "npm run check:electron-only && npm run typecheck && npm run lint && npm test && npm run build",
    "package": "npm run build && electron-builder --dir",
    "lint": "eslint apps packages vite.config.ts",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:account": "node scripts/smoke-account.mjs",
    "test:lens-actions": "node scripts/smoke-lens-actions.mjs",
    "test:canvas": "node scripts/smoke-canvas.mjs",
    "test:math": "node scripts/smoke-math.mjs",
    "test:notebook": "node scripts/smoke-notebook.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.2.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "com.henryvanness.thedesk.v1",
    "productName": "The Desk V1",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education"
    },
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      }
    ]
  },
  "description": "Local-first academic workspace",
  "author": "Henry Van Ness",
  "overrides": {
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    }
  }
}
