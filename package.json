{
  "name": "the-desk",
  "version": "1.0.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/**/*.test.ts",
    "start": "node scripts/start.mjs",
    "check:electron-only": "node scripts/check-electron-only.mjs",
    "check": "npm run check:electron-only && npm run typecheck && npm run lint && npm test && npm run test:extension && npm run build",
    "test:extension": "npx tsx --test apps/extension/test/*.test.ts",
    "package": "npm run build && electron-builder --dir",
    "lint": "eslint apps packages vite.config.ts",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:account": "node scripts/smoke-account.mjs",
    "test:cloud-sync": "node scripts/smoke-cloud-sync.mjs",
    "test:cloud-sync-conflict": "node scripts/smoke-cloud-sync-conflict.mjs",
    "test:acceptance:v1": "node scripts/smoke-acceptance-v1.mjs",
    "test:migration-recovery": "node scripts/smoke-migration-recovery.mjs",
    "test:release-boundaries": "node scripts/smoke-release-boundaries.mjs",
    "test:browser-bridge": "node scripts/smoke-browser-bridge.mjs",
    "test:session-evidence": "node scripts/smoke-session-evidence.mjs",
    "test:lens-actions": "node scripts/smoke-lens-actions.mjs",
    "test:canvas": "node scripts/smoke-canvas.mjs",
    "test:math": "node scripts/smoke-math.mjs",
    "test:notebook": "node scripts/smoke-notebook.mjs",
    "test:notes": "node scripts/smoke-notes.mjs",
    "test:first-run": "node scripts/smoke-first-run.mjs",
    "test:chat-provider": "node scripts/smoke-chat-provider.mjs",
    "test:packaged-provider": "node scripts/smoke-packaged-provider.mjs",
    "test:packaged-study": "node scripts/smoke-packaged-study.mjs",
    "test:student-model": "node scripts/smoke-student-model.mjs",
    "test:intelligence": "node scripts/smoke-intelligence.mjs",
    "benchmark:planner": "tsx scripts/benchmark-planner.mjs",
    "benchmark:notes": "tsx scripts/benchmark-notes.mjs",
    "benchmark:library": "tsx scripts/benchmark-library.mjs",
    "benchmark:home": "tsx scripts/benchmark-home.mjs",
    "benchmark:class": "tsx scripts/benchmark-class.mjs",
    "benchmark:capture": "tsx scripts/benchmark-capture.mjs",
    "benchmark:intelligence": "tsx scripts/benchmark-intelligence.ts",
    "test:capture": "node scripts/smoke-capture.mjs",
    "test:class": "node scripts/smoke-class.mjs",
    "test:study-quality": "tsx scripts/smoke-study-quality.mjs",
    "test:study-artifacts": "node scripts/smoke-study-artifacts.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@untitledui/icons": "^0.0.22",
    "mathjs": "15.2.0",
    "react": "19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.2.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "com.henryvanness.thedesk.v1",
    "productName": "The Desk V1",
    "directories": {
      "output": "release"
    },
    "icon": "assets/the-desk-icon.png",
    "files": [
      "dist/**",
      "dist-electron/**",
      "dist-extension/**",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education"
    },
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "dist-electron/lens-hotkey",
        "to": "lens-hotkey"
      }
    ]
  },
  "description": "Local-first academic workspace",
  "author": "Henry Van Ness",
  "overrides": {
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    }
  }
}
